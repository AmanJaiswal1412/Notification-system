# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated list of frontend origins (Vercel URL in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Leave empty to use local SQLite. On Render this is injected by the Postgres add-on.
DATABASE_URL=

# ---- Bootstrap admin (used by `manage.py seed_defaults`) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

SITE_NAME=Notify Demo

# ---- WhatsApp Cloud API (sandbox) ----
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
# Needed only to create / sync templates from the admin panel
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Email: postmark | brevo | resend ----
EMAIL_PROVIDER=postmark
# Postmark
POSTMARKAPP_TOKEN=
POSTMARK_FROM_EMAIL=
# Brevo
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Web Push (OneSignal) ----
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Send notifications in a background thread so API calls stay fast
NOTIFICATIONS_ASYNC=True
